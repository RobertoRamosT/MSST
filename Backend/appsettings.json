{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "OdbcDriver": ""
  },
  "Security": {
    "DataProtectionKeysPath": "",
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60
  },
  "Evidence": {
    "RootPath": "",
    "CertificateTrustMode": "System"
  },
  "Web": {
    "AllowedOrigins": [],
    "FrontendRoot": "",
    "TrustedProxies": [],
    "ForwardLimit": 1
  },
  "Data": {
    "DefaultPageSize": 50,
    "MaximumPageSize": 200,
    "CursorMinutes": 15
  },
  "Operations": {
    "ReadinessTimeoutSeconds": 5
  }
}
