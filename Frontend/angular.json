{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "msst-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "msst",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/msst-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public/sstweb/imagenes",
                "output": "sstweb/imagenes"
              },
              {
                "glob": "bootstrap-s.css",
                "input": "public/sstweb/css",
                "output": "sstweb/css"
              },
              {
                "glob": "**/*",
                "input": "public/sstweb/lib/font-awesome-4.7.0/css",
                "output": "sstweb/lib/font-awesome-4.7.0/css"
              },
              {
                "glob": "**/*",
                "input": "public/sstweb/lib/font-awesome-4.7.0/fonts",
                "output": "sstweb/lib/font-awesome-4.7.0/fonts"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "8mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "msst-frontend:build:production"
            },
            "development": {
              "buildTarget": "msst-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
